# Адрес базы PostgreSQL (подставляется PipeCore автоматически)
DATABASE_URL=
# Email владельца сайта: с него вход в панель организатора
OWNER_EMAIL=
# Почта для писем с кодом входа (например Яндекс 360: smtp.yandex.ru, порт 465)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
# Пароль приложения почтового ящика (не обычный пароль)
SMTP_PASS=
# Адрес отправителя, обычно совпадает с SMTP_USER
MAIL_FROM=
PORT=3000
